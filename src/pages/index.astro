---
import BaseLayout from '../layouts/BaseLayout.astro'
import HomeHero from '../components/HomeHero.astro'
import HomeBelowFoldTop from '../components/HomeBelowFoldTop.astro'
import { HomeFeaturePreview } from '../views/HomeFeaturePreview'
import { HomeBelowFoldBottom } from '../views/HomeBelowFoldBottom'
import { SEO } from '../data/site'
import { productCoreJsonLd } from '../lib/seo'
---

<BaseLayout
  seo={SEO.home}
  jsonLdExtra={[productCoreJsonLd()]}
>
  <HomeHero />
  <HomeBelowFoldTop />
  <HomeFeaturePreview client:visible />
  <HomeBelowFoldBottom client:idle />
</BaseLayout>
