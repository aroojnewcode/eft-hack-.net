---
import BaseLayout from '../layouts/BaseLayout.astro'
import { NotFoundPage } from '../views/NotFoundPage'
import { SITE_NAME, OG_IMAGE, type PageSeo } from '../data/site'

const seo: PageSeo = {
  title: `Page Not Found — EFT Hack Guides | ${SITE_NAME}`,
  description:
    'This URL is not on efthack.net. Go home for live BattlEye status, or open the forums for Aimbot, ESP, radar and setup guides before checkout.',
  path: '/404',
  image: OG_IMAGE,
  robots: 'noindex, follow',
  ogType: 'website',
}
---

<BaseLayout seo={seo}>
  <NotFoundPage client:idle />
</BaseLayout>

