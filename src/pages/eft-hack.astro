---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Navbar } from '../components/Navbar'
import { SiteFooter } from '../components/SiteFooter'
import ProductCheckoutDetails from '../components/ProductCheckoutDetails.astro'
import { ProductPurchaseCard } from '../components/ProductPurchaseCard'
import { EftProductPreview } from '../components/EftProductPreview'
import { FaqSection } from '../components/FaqSection'
import { PRODUCT_PATH, SEO, SITE_HOST, SITE_NAME, SITE_URL, PRODUCT_PRICE_USD } from '../data/site'
import { productDetailJsonLd } from '../lib/seo'
import { GAMES, GUIDE_FEATURES, getGame } from '../data/games'
import { PRODUCT_PAGE_FAQS } from '../data/faqs'
import { blogPath } from '../data/blogs'
import { EFT_HOME_VIDEO } from '../data/media'

const game = getGame('eft') ?? GAMES[0]

const jsonLdExtra = [
  productDetailJsonLd(game.status),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'EFT Hack', item: `${SITE_URL}${PRODUCT_PATH}` },
    ],
  },
]
---

<BaseLayout seo={SEO.product} jsonLdExtra={jsonLdExtra}>
  <div class="content-surface min-h-screen overflow-x-hidden text-white">
    <div class="content-surface-nav">
      <Navbar client:idle />
    </div>

    <main>
      <section class="page-x py-8 sm:py-12">
        <div class="mx-auto max-w-6xl">
          <nav
            class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-white/40"
            aria-label="Breadcrumb"
          >
            <a href="/" class="shrink-0 hover:text-white/70">Home</a>
            <span class="shrink-0">/</span>
            <span class="min-w-0 text-white/70">Product details</span>
          </nav>

          <div class="mt-6 grid gap-8 sm:mt-8 lg:mt-12 lg:grid-cols-12 lg:items-start lg:gap-10">
            <div class="lg:col-span-7">
              <span class="inline-flex items-center gap-1.5 text-xs text-z-soft">
                <span aria-hidden="true">🛡</span>
                {game.status} · Escape From Tarkov · anti-cheat · {SITE_HOST}
              </span>

              <h1 class="mt-3 text-2xl font-semibold leading-tight tracking-tight text-white sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
                EFT Hack Price & Checkout
              </h1>
              <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/55 sm:mt-4 sm:text-base">
                Buy an Escape From Tarkov hack license from ${PRODUCT_PRICE_USD} — silent aim Aimbot,
                player ESP, wallhack and radar on Windows PC. Confirm live BattlEye status on {SITE_HOST},
                then checkout for instant digital delivery worldwide.
              </p>

              <ProductCheckoutDetails game={game} />

              <div class="mt-6 lg:hidden">
                <ProductPurchaseCard client:idle game={game} />
              </div>
            </div>

            <aside class="hidden lg:col-span-5 lg:block">
              <div class="sticky top-24">
                <ProductPurchaseCard client:idle game={game} />
              </div>
            </aside>
          </div>

          <div class="mt-10 border-t border-white/10 pt-10 sm:mt-12 sm:pt-12">
            <h2 class="text-lg font-semibold tracking-tight text-white sm:text-xl">Feature preview</h2>
            <p class="mt-2 max-w-2xl text-sm text-white/45">
              {EFT_HOME_VIDEO.caption} Switch Match, Combat and Push tabs — then tap Video for the full
              clip.
            </p>
            <EftProductPreview client:visible className="mt-4" />
          </div>

          <div class="mt-10 max-w-3xl sm:mt-12">
            <h2 class="text-lg font-semibold tracking-tight text-white sm:text-xl">Included features</h2>
            <ul class="mt-4 space-y-3">
              {
                GUIDE_FEATURES.map((f) => (
                  <li class="flex items-start gap-3">
                    <span
                      class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-z-accent/20 text-z-soft text-xs"
                      aria-hidden="true"
                    >
                      ✓
                    </span>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-white">{f.name}</p>
                      <p class="mt-0.5 text-sm leading-relaxed text-white/50">{f.text}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="mt-12 max-w-3xl space-y-8 text-sm leading-relaxed text-white/55">
            <div>
              <h2 class="text-lg font-semibold tracking-tight text-white sm:text-xl">Raids & BattlEye</h2>
              <p class="mt-3">
                Built for PMC raids, SCAV runs and offline on Escape From Tarkov. After a client or
                anti-cheat patch, status may show Updating until tested — {SITE_NAME} publishes live
                status so you are not buying a dead loader. Status first, load second.
              </p>
            </div>
            <div>
              <h2 class="text-lg font-semibold tracking-tight text-white sm:text-xl">
                Checkout and delivery
              </h2>
              <ol class="mt-3 list-decimal space-y-2 pl-5">
                <li>Confirm current status on {SITE_HOST}.</li>
                <li>Only load when status is clear (or accept Updating risk).</li>
                <li>Checkout for digital license delivery worldwide.</li>
                <li>
                  Follow the{' '}
                  <a href={blogPath('complete-setup')} class="text-white/80 underline-offset-2 hover:underline">
                    complete setup guide
                  </a>{' '}
                  after delivery.
                </li>
              </ol>
            </div>
          </div>
        </div>
      </section>

      <FaqSection
        client:idle
        heading="EFT Hack product FAQ"
        intro="Status, features, server support, delivery and load questions before checkout."
        items={PRODUCT_PAGE_FAQS}
      />
    </main>

    <SiteFooter client:idle currentPath={PRODUCT_PATH} />
  </div>
</BaseLayout>
