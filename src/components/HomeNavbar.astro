---
import { CHECKOUT_URL } from '../data/links'
import { PRODUCT_PATH, SITE_NAME } from '../data/site'

const NAV_LINKS = [
  { label: 'Home', to: '/' },
  { label: 'Forums', to: '/forums' },
  { label: 'Product', to: PRODUCT_PATH },
  { label: 'Reviews', to: '/reviews' },
  { label: 'FAQ', to: '/faq' },
  { label: 'Support', to: '/support' },
] as const
---

<nav class="page-x relative z-20 flex items-center justify-between gap-3 py-4 sm:py-5" aria-label="Main">
  <a href="/" class="flex min-w-0 items-center gap-2.5">
    <svg width="24" height="24" viewBox="0 0 256 256" class="shrink-0 text-z-soft" aria-hidden="true">
      <path
        fill="currentColor"
        d="M 128 128 C 128 198.692 70.692 256 0 256 C 0 185.308 57.308 128 128 128 Z M 128 128 C 198.692 128 256 185.308 256 256 C 185.308 256 128 198.692 128 128 Z M 0 0 C 70.692 0 128 57.308 128 128 C 57.308 128 0 70.692 0 0 Z M 256 0 C 256 70.692 198.692 128 128 128 C 128 57.308 185.308 0 256 0 Z"
      ></path>
    </svg>
    <span class="truncate text-sm font-semibold tracking-tight text-z-ink sm:text-base">{SITE_NAME}</span>
  </a>

  <div class="hidden items-center gap-2 md:flex">
    <div class="nav-chip flex items-center gap-0.5 rounded-full px-1 py-1">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.to}
            class="inline-flex items-center rounded-full px-3.5 py-1.5 text-sm font-medium text-z-ink/70 transition-colors hover:bg-z-accent/15 hover:text-z-ink"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <a
      href={CHECKOUT_URL}
      rel="nofollow"
      class="cta-gradient flex items-center self-stretch rounded-full px-5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
    >
      Get
    </a>
  </div>

  <details class="home-nav-mobile relative z-50 md:hidden">
    <summary
      class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-z-soft/25 bg-z-elevated/80 text-z-ink backdrop-blur-lg [&::-webkit-details-marker]:hidden"
      aria-label="Open menu"
    >
      <span class="text-lg leading-none" aria-hidden="true">☰</span>
    </summary>
    <div
      class="absolute right-0 top-12 w-56 rounded-2xl border border-z-soft/20 bg-z-elevated/95 p-2 shadow-xl backdrop-blur-xl"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.to}
            class="block rounded-xl px-4 py-2.5 text-sm font-medium text-z-ink/80 hover:bg-z-accent/15 hover:text-z-ink"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={CHECKOUT_URL}
        rel="nofollow"
        class="cta-gradient mt-2 block rounded-full px-4 py-2.5 text-center text-sm font-semibold text-white"
      >
        Get
      </a>
    </div>
  </details>
</nav>

<style>
  .home-nav-mobile:not([open]) > div {
    display: none;
  }
</style>
