---
import { Navbar } from './Navbar'
import { EFT_HERO_POSTER, EFT_HERO_POSTER_ALT } from '../data/media'
import { SITE_HOST } from '../data/site'
---

<section
  id="forums-hero"
  class="relative flex min-h-[60vh] flex-col overflow-x-clip sm:min-h-[65vh]"
>
  <div class="hero-video-wrap absolute inset-0 z-0 overflow-hidden pointer-events-none select-none">
    <div class="absolute inset-0 z-0 bg-z-bg" aria-hidden="true"></div>
    <img
      src={EFT_HERO_POSTER}
      alt={EFT_HERO_POSTER_ALT}
      width="1024"
      height="499"
      decoding="async"
      fetchpriority="high"
      class="home-hero-poster hero-video-bg absolute inset-0 z-[1] h-full w-full object-cover"
      style="object-position: right center"
    />
    <div class="home-hero-tint hero-video-tint pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
    <div class="home-hero-tint-glow hero-video-tint-glow pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
    <div class="home-hero-fade-bottom absolute inset-x-0 bottom-0 z-[3] h-32 bg-gradient-to-t from-z-bg/85 via-z-bg/35 to-transparent"></div>
    <div class="home-hero-fade-top absolute inset-x-0 top-0 z-[3] h-16 bg-gradient-to-b from-z-bg/35 to-transparent"></div>
  </div>

  <div class="relative z-20 flex min-h-[60vh] flex-col sm:min-h-[65vh]">
    <Navbar client:idle />
    <div class="page-x mt-auto pb-10 sm:pb-14">
      <div class="relative z-30 mx-auto max-w-6xl">
        <p class="home-hero-eyebrow mb-3 text-xs font-semibold uppercase tracking-[0.2em]">
          Forums · Setup · {SITE_HOST}
        </p>
        <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-5xl">EFT Hack Guides</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/70">
          Setup threads for EFT Hack — features, hotkeys, complete setup, disable antivirus, how to
          load, and live BattlEye anti-cheat status before you checkout.
        </p>
      </div>
    </div>
  </div>
</section>

<div class="hero-to-body" aria-hidden="true"></div>
