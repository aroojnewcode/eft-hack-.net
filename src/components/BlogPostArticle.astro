---
import { Navbar } from './Navbar'
import { SiteFooter } from './SiteFooter'
import { BlogPostCta } from './BlogPostCta'
import { BLOGS, blogPath, type BlogPost } from '../data/blogs'
import { sectionId } from '../lib/section-id'
import { SITE_HOST } from '../data/site'

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const related = BLOGS.filter((b) => b.slug !== post.slug).slice(0, 6)
const currentPath = blogPath(post.slug)
---

<div class="min-h-screen overflow-x-hidden bg-z-bg text-white">
  <div class="border-b border-z-soft/15 bg-z-bg/90 backdrop-blur-xl">
    <Navbar client:idle />
  </div>

  <main class="page-body">
    <article class="page-x py-10 sm:py-14">
      <div class="mx-auto max-w-3xl">
        <nav
          class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-white/55"
          aria-label="Breadcrumb"
        >
          <a href="/" class="text-white/60 hover:text-white/80">Home</a>
          <span class="text-white/45">/</span>
          <a href="/forums" class="text-white/60 hover:text-white/80">Forums</a>
          <span>/</span>
          <span class="text-white/70">{post.tag}</span>
        </nav>

        <p class="mt-6 text-xs font-medium uppercase tracking-[0.2em] text-white/55">
          {post.tag} · {post.readMinutes} min read · {post.date}
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {post.title}
        </h1>
        <p class="mt-4 text-base leading-relaxed text-white/60 sm:text-lg">{post.excerpt}</p>

        <div class="mt-10 space-y-10">
          {
            post.sections.map((section) => (
              <section id={sectionId(section.heading)} class="scroll-mt-24">
                <h2 class="text-xl font-semibold tracking-tight text-white sm:text-2xl">
                  {section.heading}
                </h2>
                <div class="mt-3 space-y-3 text-sm leading-relaxed text-white/55 sm:text-base">
                  {section.body.map((para) => <p>{para}</p>)}
                </div>
              </section>
            ))
          }
        </div>

        <BlogPostCta client:idle siteHost={SITE_HOST} />

        <a
          href="/forums"
          class="mt-10 inline-flex items-center gap-1.5 text-sm text-white/55 hover:text-white"
        >
          ← All forum threads
        </a>
      </div>
    </article>

    {
      related.length > 0 ? (
        <section class="page-band page-x border-t border-white/10 py-12 sm:py-16">
          <div class="mx-auto max-w-6xl">
            <h2 class="text-xl font-semibold tracking-tight text-white">More forum threads</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((b) => (
                <a
                  href={blogPath(b.slug)}
                  class="page-card group flex h-full flex-col rounded-2xl p-5"
                >
                  <p class="text-xs uppercase tracking-wider text-white/55">{b.tag}</p>
                  <h3 class="mt-2 text-sm font-semibold text-white group-hover:text-white/85">
                    {b.title}
                  </h3>
                  <p class="mt-2 flex-1 text-xs leading-relaxed text-white/50">{b.excerpt}</p>
                  <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-white/70">
                    Read →
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : null
    }

    <SiteFooter client:idle currentPath={currentPath} />
  </main>
</div>
