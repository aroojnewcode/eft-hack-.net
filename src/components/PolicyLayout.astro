---
import { Navbar } from './Navbar'
import { SiteFooter } from './SiteFooter'
import type { PolicyPageContent } from '../data/policies'
import { SITE_HOST, SITE_NAME } from '../data/site'

interface Props {
  page: PolicyPageContent
}

const { page } = Astro.props
---

<div class="min-h-screen overflow-x-hidden bg-z-bg text-white">
  <div class="border-b border-z-soft/15 bg-z-bg/90 backdrop-blur-xl">
    <Navbar client:idle />
  </div>

  <main class="page-body">
    <section class="page-x pt-12 sm:pt-20">
      <div class="mx-auto max-w-3xl">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/45">
          {SITE_NAME} · Policy · {SITE_HOST}
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl">{page.h1}</h1>
        <p class="mt-4 text-base leading-relaxed text-white/55">{page.intro}</p>
      </div>
    </section>

    <section class="page-x py-12 sm:py-16">
      <div class="mx-auto flex max-w-3xl flex-col gap-6">
        {
          page.sections.map((section) => (
            <article class="page-card rounded-2xl p-6 sm:p-8">
              <h2 class="text-xl font-semibold tracking-tight text-white">{section.heading}</h2>
              <div class="mt-4 space-y-3 text-sm leading-relaxed text-white/65">
                {section.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="page-x pb-16">
      <div class="mx-auto max-w-3xl">
        <p class="text-sm text-white/45">Related</p>
        <ul class="mt-3 flex flex-wrap gap-3">
          {
            page.related.map((link) => (
              <li>
                <a
                  href={link.to}
                  class="text-sm font-medium text-white/75 underline-offset-2 hover:text-white hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <SiteFooter client:idle currentPath={page.path} />
  </main>
</div>
