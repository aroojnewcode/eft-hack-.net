---
import { Navbar } from './Navbar'
import { CHECKOUT_URL } from '../data/links'
import { HOME_HEADINGS, PRODUCT_PATH, SITE_HOST } from '../data/site'

const heroAlt =
  'Escape From Tarkov hero banner — tactical PMCs in a war-torn industrial cityscape at dusk'
---

<section id="home" class="relative flex min-h-screen flex-col overflow-x-clip text-white">
  <div class="hero-video-wrap absolute inset-0 z-0 overflow-hidden pointer-events-none select-none">
    <div class="absolute inset-0 z-0 bg-z-bg" aria-hidden="true"></div>
    <img
      src="/media/eft-hero-poster.webp"
      alt={heroAlt}
      width="1024"
      height="499"
      decoding="async"
      fetchpriority="high"
      class="home-hero-poster hero-video-bg absolute inset-0 z-[1] h-full w-full object-cover"
      style="object-position: right center"
    />
    <div
      class="home-hero-tint hero-video-tint pointer-events-none absolute inset-0 z-[2]"
      aria-hidden="true"
    >
    </div>
    <div
      class="home-hero-tint-glow hero-video-tint-glow pointer-events-none absolute inset-0 z-[2]"
      aria-hidden="true"
    >
    </div>
    <div
      class="home-hero-fade-bottom absolute inset-x-0 bottom-0 z-[3] h-32 bg-gradient-to-t from-z-bg/85 via-z-bg/35 to-transparent"
    >
    </div>
    <div
      class="home-hero-fade-top absolute inset-x-0 top-0 z-[3] h-16 bg-gradient-to-b from-z-bg/35 to-transparent"
    >
    </div>
  </div>

  <div class="relative z-20 flex min-h-screen flex-col">
    <Navbar client:idle onVideo />

    <main class="page-x mt-auto pb-6 sm:pb-8 lg:pb-10">
      <div
        class="flex flex-col gap-5 sm:gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10"
      >
        <div class="relative z-30 max-w-md lg:max-w-lg">
          <p
            class="home-hero-eyebrow mb-2.5 text-[11px] font-semibold uppercase tracking-[0.18em] sm:mb-3 sm:text-xs sm:tracking-[0.2em]"
          >
            Escape From Tarkov · Worldwide · {SITE_HOST}
          </p>
          <h1
            class="text-[1.75rem] font-semibold leading-[1.12] tracking-tight text-white sm:text-4xl lg:text-[2.65rem] lg:leading-[1.1]"
          >
            {HOME_HEADINGS.h1}
          </h1>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-white/70 sm:mt-3.5 sm:text-[0.95rem]">
            Escape From Tarkov cheats for Windows 10 and 11 — silent aim Aimbot, player ESP,
            wallhack, radar and a clear cheat menu. Live BattlEye status on PMC raids, SCAV runs and
            offline raids.
          </p>

          <div class="relative z-50 mt-5 flex flex-col gap-2.5 sm:flex-row sm:items-center">
            <a
              href={CHECKOUT_URL}
              rel="nofollow"
              class="cta-gradient inline-flex items-center justify-center rounded-full px-6 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
            >
              Buy EFT Hack
            </a>
            <a
              href={PRODUCT_PATH}
              class="inline-flex items-center justify-center rounded-full border border-z-soft/35 bg-[rgba(28,22,48,0.88)] px-5 py-2.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] backdrop-blur-xl transition-[background-color,border-color] hover:border-z-soft/50 hover:bg-[rgba(36,28,58,0.95)]"
            >
              Product details
            </a>
          </div>
        </div>

        <div
          class="relative z-10 grid w-full grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:w-[30rem] lg:shrink-0"
        >
          <div
            class="glass flex h-full min-h-[140px] flex-col justify-between rounded-2xl p-4 sm:min-h-[160px] sm:p-5"
          >
            <p class="status-pill font-mono text-2xl font-bold tracking-tight sm:text-3xl">UD</p>
            <p class="mt-2.5 text-xs leading-relaxed text-white/70 sm:mt-3 sm:text-sm">
              Live anti-cheat status for Escape From Tarkov. Updated after patches — not random
              Discord screenshots.
            </p>
          </div>

          <div class="glass flex h-full min-h-[140px] flex-col rounded-2xl p-4 sm:min-h-[160px] sm:p-5">
            <div class="mb-2.5 flex items-center gap-2 sm:mb-3">
              <div
                class="flex h-5 w-5 items-center justify-center rounded bg-z-accent/30 text-[10px] font-bold text-z-soft sm:h-6 sm:w-6 sm:text-xs"
              >
                EFT
              </div>
              <span class="text-sm font-semibold text-white">Escape From Tarkov</span>
            </div>
            <p class="flex-1 text-xs leading-relaxed text-white/80 sm:text-sm">
              “Bought it for ESP and mild silent aim. Status stayed honest after the last anti-cheat
              rebuild — finally an honest status shop.”
            </p>
            <div class="mt-3 flex items-center gap-2.5 sm:mt-4 sm:gap-3">
              <div
                class="flex h-8 w-8 items-center justify-center rounded-full bg-z-accent/25 text-xs font-semibold text-z-ink sm:h-9 sm:w-9 sm:text-sm"
              >
                JK
              </div>
              <div>
                <p class="text-sm font-semibold text-white">jayk</p>
                <p class="text-xs text-white/60">EFT player</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</section>

<div class="hero-to-body" aria-hidden="true"></div>
